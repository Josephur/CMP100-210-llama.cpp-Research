+    // Load tensor data. This path is opt-in because positional reads and one
+    // upload worker per GPU are beneficial only on suitable storage/topologies.
+    const char * parallel_env = std::getenv("LLAMA_MODEL_LOAD_PARALLEL");
+    const bool parallel_requested = parallel_env != nullptr && std::strcmp(parallel_env, "1") == 0;
+    const bool parallel_eligible = !ml.use_mmap && !ml.use_direct_io && !ml.check_tensors;
+
+    std::vector<size_t> host_loads;
+    std::vector<size_t> gpu_loads;
+    for (size_t i = 0; i < ctx_buf_maps.size(); ++i) {
+        ggml_tensor * first = ggml_get_first_tensor(ctx_buf_maps[i].first);
+        GGML_ASSERT(first != nullptr && first->buffer != nullptr);
+        if (ggml_backend_buffer_is_host(first->buffer)) {
+            host_loads.push_back(i);
+        } else {
+            gpu_loads.push_back(i);
+        }
+    }
+
+    const bool parallel_load = parallel_requested && parallel_eligible && gpu_loads.size() > 1;
+    const auto load_one = [&](size_t i, bool positional_reads) {
+        auto & [ctx, buf_map] = ctx_buf_maps[i];
+        return ml.load_all_data(ctx, buf_map, use_mlock ? &pimpl->mlock_mmaps : NULL,
+                                params.progress_callback, params.progress_callback_user_data,
+                                positional_reads);
+    };
+
+    if (parallel_load) {
+        // Host tensors are loaded first. GPU contexts then use positional reads
+        // so independent backend uploads can overlap without sharing file offsets.
+        for (size_t i : host_loads) {
+            if (!load_one(i, false)) {
+                return false;
+            }
+        }
+
+        std::vector<std::future<bool>> futures;
+        futures.reserve(gpu_loads.size());
+        for (size_t i : gpu_loads) {
+            futures.emplace_back(std::async(std::launch::async, [&, i] {
+                return load_one(i, true);
+            }));
+        }
+
+        std::exception_ptr first_exception;
+        bool loaded = true;
+        for (auto & future : futures) {
+            try {
+                loaded = future.get() && loaded;
+            } catch (...) {
+                if (!first_exception) {
+                    first_exception = std::current_exception();
+                }
+            }
+        }
+        if (first_exception) {
+            std::rethrow_exception(first_exception);
+        }
+        if (!loaded) {
             return false;
         }
+    } else {
+        for (size_t i = 0; i < ctx_buf_maps.size(); ++i) {
+            if (!load_one(i, false)) {
+                return false;
+            }
+        }
     }
 
     if (use_mmap_buffer) {
